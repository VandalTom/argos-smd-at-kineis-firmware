{
    // Cloudflare Workers config for the Naiad commissioning tool: the static
    // page (Tools/naiad_tool.html, copied to dist/ by build.mjs) plus a small
    // API in src/worker.js (firmware releases, the team credentials vault).
    // Deployed by Workers Builds on push to naiad. Build settings in the
    // Cloudflare dashboard:
    //   root directory  web/naiad-tool
    //   build command   npm run build
    //   deploy command  npx wrangler deploy
    // Web Serial needs a secure context: the custom domain (and workers.dev)
    // are HTTPS, so the tool can open serial ports from there.
    "name": "naiad-tool",
    "main": "src/worker.js",
    "compatibility_date": "2026-07-01",
    // Public address (custom domain: Cloudflare creates the DNS record and
    // certificate on deploy; the zone is in the same account). The
    // workers.dev address stays on as a fallback (the vault refuses requests
    // that did not come through Cloudflare Access, so it is closed there).
    "routes": [
        { "pattern": "arribada.siliconvandals.com", "custom_domain": true }
    ],
    "workers_dev": true,
    // Static files are served before the Worker runs; only /api/* (no such
    // file) reaches src/worker.js.
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "vars": {
        "GITHUB_REPO": "VandalTom/argos-smd-at-kineis-firmware",
        "ALLOWED_EMAIL_DOMAIN": "siliconvandals.com",
        // Cloudflare Access (Zero Trust team "siliconvandals"), application
        // "Naiad team vault" on arribada.siliconvandals.com/api/vault, policy
        // "siliconvandals staff" (emails ending in @siliconvandals.com). Both
        // are public identifiers; the Worker checks every token against them.
        "ACCESS_TEAM_DOMAIN": "siliconvandals.cloudflareaccess.com",
        "ACCESS_AUD": "67b385d84b52a1343076f9dc64ae45c73890fb242c00e44940add8156b50c8ad"
    },
    // Variables added in the dashboard (e.g. ACCESS_*) survive deploys.
    "keep_vars": true,
    // The team vault's database (Storage & Databases > D1 > naiad-vault).
    // The tables are created by the Worker on first use.
    "d1_databases": [
        { "binding": "DB", "database_name": "naiad-vault", "database_id": "666f75f1-3262-4f77-b1d2-1d39dc02dca7" }
    ],
    "observability": { "enabled": true }
}
